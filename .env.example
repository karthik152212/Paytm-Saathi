# Copy to .env (or export in your shell) before starting the backend.
# Every value below is the default — the app runs with none of these set.

# SQLAlchemy URL. Any SQLAlchemy URL works; the demo uses SQLite.
SAATHI_DATABASE_URL=sqlite:///./runtime/saathi.db

# Where the JSON seed files live (defaults to <repo>/datasets).
SAATHI_DATASETS_DIR=./datasets

# Seed the database from datasets/*.json on startup when it is empty (1/0).
SAATHI_SEED_ON_START=1

# Allow the destructive POST /api/dev/reseed endpoint (1/0).
# Intended for local development and demo resets only — never enable in a shared deploy.
SAATHI_ALLOW_RESET=0

# Which user the API serves when no user_id query parameter is given.
SAATHI_DEFAULT_USER_ID=usr_001

# Frontend only: where the Vite dev proxy sends /api requests.
VITE_DEV_API_TARGET=http://localhost:8000
